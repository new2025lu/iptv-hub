TZ=Asia/Shanghai
PUID=1000
PGID=1001
IPTV_PORT=18787
SYNC_HOUR=3
SYNC_MINUTE=0
STARTUP_SYNC_DELAY=8
REQUEST_TIMEOUT=45
IPTV_ADMIN_TOKEN=
APP_NAME=IPTV Hub
# 应用版本号（唯一来源）：页面标题与 /api/meta 的 version 字段都取它
APP_VERSION=v6
AUTO_SPEED_AFTER_SYNC=true
AUTO_SPEED_LIMIT=1500
# 自适应预算：按存量与复检周期折算每天需要测多少条（未测全量 + 可用/72h + 失效/20h），
# 需求量高于 AUTO_SPEED_LIMIT 时自动上调，上限 AUTO_SPEED_MAX。
# 不建议关闭：固定小预算会被每天全部到期的失效线路吃光，可用线路长期不复检、
# fail_count 涨不到剔除阈值，「标记 -> 剔除 -> 复活」流水线会冻结。
AUTO_SPEED_ADAPTIVE=true
AUTO_SPEED_MAX=20000
AUTO_SPEED_REGION=
AUTO_PRUNE_AFTER_SPEED=true
PRUNE_MAX_FAIL=3
RETEST_AFTER_DAYS=14
FAIL_RETEST_HOURS=20
RETEST_OK_HOURS=72
# v48 长期失效清理：连续失效且**持续超过**这个天数的线路，在每周维护里把它的
# source_entries 置为 active=0（只停用条目，不删数据、不改 region，可用
# POST /api/prune/restore 按 fingerprint 放回）。每个频道保底留 1 条，
# 不会让频道整体从订阅里消失。0 = 关闭（此时行为与加这个特性之前完全一致）。
#
# 判据（四条全满足，详见 speed.cleanup_long_dead_streams 的 docstring）：
#   1) 条目 active=1 且健康行存在；
#   2) 健康行 status IN ('error','unsupported') —— 当前仍判死
#      （blocked 不参与：那是「我们没测成」，不是「线路坏」）；
#   3) 新列 stream_health.dead_since（连续失效起点）距今 >= 本值。存量行的 dead_since
#      一律留空、在 v48 后第一次测得失败时才开始计时，所以**升级当天不会批量停用**，
#      最早的有效清理在开启后约 N 天；
#   4) status <> 'purged'（已永久停用的不重复处理）。
#
# 为什么需要它：AUTO_PRUNE_AFTER_SPEED 关闭后「标记 → 剔除」流水线冻结，
# 判死但仍 active 的条目会持续堆积（实测一度占活跃条目的三成）。
# 建议 30：与 RETEST_AFTER_DAYS(14) 错开，避免一条线路在「刚要复活重测」的同一周被停用。
AUTO_CLEANUP_DEAD_DAYS=0
# 季度清理：每 PURGE_INTERVAL_DAYS 天扫一次，把「复活过、复活后仍然失效」的线路永久停用
# （status='purged' 墓碑语义：不再测速、不进订阅、同步再抓到也不复活；可撤销）
PURGE_INTERVAL_DAYS=90
PURGE_MIN_REVIVE=1
# 每周维护（同步末尾按 7 天节流自动跑，也可 POST /api/maintenance 手动触发）
SYNC_RUNS_KEEP=100
INACTIVE_RETENTION_DAYS=30
# 频道详情里在主用线路之外额外展示的备选线路条数
BACKUP_LINES_SHOWN=5
# 测速采样：先丢弃 SPEED_WARMUP_BYTES（CDN 边缘预缓冲），只用剩余部分算「持续吞吐」
SPEED_WARMUP_BYTES=524288
SPEED_SAMPLE_BYTES=1048576
SPEED_TIMEOUT=5
SPEED_CONCURRENCY=64
SPEED_MAX_ITEMS=5000
# 测速目标地址守卫的例外主机（逗号分隔）。默认拦截内网/环回/链路本地/保留地址，
# 因为频道地址来自第三方列表，不拦等于开了盲 SSRF；你自己的内网源写在这里。
# 数据源白名单 ALLOWED_SOURCE_HOSTS（内置 + 手动放行）里的主机自动信任，无需重复。
SPEED_ALLOW_PRIVATE_HOSTS=
# 多线路订阅/频道详情：每个频道保留的线路条数（央视系频道用 MAX_LINES_CCTV）
MAX_LINES_PER_CHANNEL=5
MAX_LINES_CCTV=10
# 导出时隐藏「判定失效」的线路（非破坏性：库里保留、继续复检，只是不进订阅产物）。
# EXPORT_DEAD_FAIL_COUNT 是判定阈值：连续失败达到这个次数才算死（默认与 PRUNE_MAX_FAIL 一致）。
EXPORT_HIDE_DEAD=true
EXPORT_DEAD_FAIL_COUNT=3
# v52 回放（catch-up）：给「具备回看能力的数据源」的线路在 M3U 的 #EXTINF 上补
# catchup / catchup-days / catchup-source，播放器（Kodi IPTV Simple、TiviMate 等）据此把
# EPG 里的往期节目拼成回看地址。只加属性，不改直播地址；不支持的播放器会忽略这些属性。
# 注意：回看需要**源站**支持时移，别的数据源没有这个能力，所以只给下面 slug 列表里的源加。
EXPORT_CATCHUP=true
# 允许挂回看属性的数据源 slug（逗号分隔）。默认只有内置源 ysp-live（本地中继 ysp-live v9.0，
# 它自己的 /all.m3u 就带 catchup 属性，服务端实测吃 ?playseek= / ?start= / ?utc=）。
# 判定按 source_slug，不按 URL —— 同一个 host:port 被别的源收录时不会跟着沾光。
EXPORT_CATCHUP_SOURCE_SLUGS=ysp-live
# 回看窗口天数（写进 catchup-days；ysp-live 声明 7 天，实测边界：整 7 天前仍返回 VOD 回看流，
# 7 天 1 小时前起**静默退回直播流**，所以 7 就是源站上限，调大只会让播放器显示点不动的节目单）
EXPORT_CATCHUP_DAYS=7
# catchup-source 模板。留空 = 内置默认（与 ysp-live 自己发布的写法逐字符相同）：
#   ?playseek=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}
# 两种形状决定写哪种 catchup 模式（Kodi 的语义，不由用户另填）：
#   * 以 ? 或 & 开头 → catchup="append"：整串拼到频道地址后面；
#   * 以 http:// 或 https:// 开头 → catchup="default"：整条回看地址由它给出。
# 模板里 {slug} 在**导出时**替换成频道名（取自线路地址最后一段）；{utc} {lutc} ${end}
# ${(b)yyyyMMddHHmmss} 等占位符**原样留给播放器**替换（导出时替换会把时间冻死）。
# 常见写法（两种源站都实测可用，区别只在播放器认哪种占位符）：
#   ?utc={utc}&lutc={lutc}                                 # TiviMate/SIPTV 风格，不含 $，最省事
#   ?playseek=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}     # Kodi/时移风格（$ 要按下面说明转义）
#   ?start={utc}&end=${end}                                # 精确到节目起止（Kodi 记法）
#   http://<源站地址>/{slug}.m3u8?start={utc}&end=${end}   # 整条地址（default 模式）
# ⚠ 在 .env / docker-compose 里，含 `$` 的模板必须把 `$` 写成 `$$`（compose 会先做一次变量
#   插值，不转义会被吃掉或报错）。用不含 `$` 的写法（?utc={utc}&lutc={lutc}）可以完全绕开。
# v53：本机已切成 TiviMate 风格（改回 Kodi 风格见上方 ?playseek= 那行，$ 写成 $$）。
EXPORT_CATCHUP_SOURCE="?utc={utc}&lutc={lutc}"
# v53 偏好源（逗号分隔的 source_slug）：线路排序键的**第一优先级** —— 这些源的线路在同一频道内
# 排到最前（其后仍按速度/稳定性等原键排序），目的是让有回看能力的数据源拿到频道的「线路 1」
# （播放器的回看入口通常只挂在线路 1）。默认 ysp-live：实测 6,159 条线路里它只有 22 条能排到
# 前面、22 个频道带得上回看属性；开启后 61 条线路、60 个频道，且非偏好频道逐字节不变。
# 留空 = 排序与 v53 之前逐字节相同（完全回退到旧行为）。
EXPORT_PREFER_SOURCES=ysp-live
# 区域保留策略：留空=国内+国外全部保留；domestic=仅国内；international=仅国外。
# 改动后启动时会检测到变化并自动排队一次强制同步，重建存量条目。
KEEP_REGION=domestic
# 主订阅默认排除的数据源分组（v43）。留空=主订阅含全部线路（老行为）。
# 设为某分组名（如「发现源」）后，**不带分组参数**的 /iptv、/playlist.m3u、/txt 以及静态
# data/live.m3u|txt 都自动排除该组 —— 播放器地址不用改就把这一组让给独立出口
# /discovered.m3u|txt（后者的地址与内容不受本配置影响）。
# 显式传分组参数时以参数为准：?exclude_group=某组 换一组排除，?exclude_group= 或 ?group=
# （空值）临时取回全量订阅。取值必须是真实存在的分组名，写错或该组已不存在时本配置自动失效
# （降级为不排除，不会让播放器 400）；生效值可在 /api/meta 的 main_exclude_group 对账。
MAIN_EXCLUDE_GROUP=
# EPG 节目单地址（上游，可含个人令牌）。配置后导出的 M3U 头部会指向本机 /epg.xml，
# 由服务端代理回源并缓存（默认 6 小时），因此**播放器不会看到这个上游地址**。
# v53：必须选**覆盖 ≥7 天**的源，否则播放器能点到的回看范围被 EPG 卡死（旧源 112114 只有
# 当天节目，即使源站能回看 7 天也没用）。实测可用：fanmingming 的 e.xml（13 个日历日：
# 过去 6 天 + 今天 + 未来 6 天、7.31MiB、123 个频道），GitHub Action 约每 4 小时更新一次。
# 备选（同源镜像）：https://cdn.jsdelivr.net/gh/fanmingming/live@main/e.xml
# ⚠ 换 EPG_URL 后必须删 data/epg-cache.xml（代理只看缓存 mtime，不看来源 URL），再重建容器。
EPG_URL=https://raw.githubusercontent.com/fanmingming/live/main/e.xml
# 本机对外地址（如 http://<主机IP>:18787）。仅用于静态文件 data/live.m3u 的
# x-tvg-url；HTTP 导出会按请求的 Host 自动推断，所以留空也能正常工作。
PUBLIC_BASE_URL=
# EPG 缓存有效期（小时）：TTL 内直接回缓存，过期才回源；回源失败回退旧缓存
EPG_PROXY_TTL_HOURS=6
# SQLite mmap 上限（0=禁用）；走 OS 页缓存，扫描类查询实测快 1.7~2.1 倍
SQLITE_MMAP_BYTES=268435456
# TVBox 配置地址（逗号分隔）：抓配置 -> 取出 lives[].url -> 子地址过白名单后按普通源同步。
# 配置里新增直播源会自动跟进；未在白名单的子主机不抓取，只在「数据源」页面提示需放行。
TVBOX_CONFIGS=
# v57「按主机走代理」：只给 SOURCE_PROXY_HOSTS 里列出的主机（含子域）**抓取订阅列表**时走代理，
# 其余一律直连。留空 = 全关，行为与改动前逐字节相同。
# 适用场景：源站对**本机出口**做了 Cloudflare 拦截、而本机代理能通。实测 `yang-1989.xyz`：
#   直连（同一台机换过两代出口 IPv4）→ 403「Sorry, you have been blocked」；
#   经本机 clash（境外节点）→ 200 / 119742 B / 461 条。
# 取值示例（clash 监听 0.0.0.0:7890；host.docker.internal 需要 compose 里的 extra_hosts）：
#   SOURCE_PROXY=http://host.docker.internal:7890
#   SOURCE_PROXY_HOSTS=yang-1989.xyz
# ⚠ 边界：**只影响抓取路径**（sync._open_source / sync.probe_manual_source）。
#   测速（speed.py）、EPG 回源（main.py）、订阅地址发现（discover.py）都不走这里 ——
#   给容器加全局 HTTP_PROXY/HTTPS_PROXY 是另一回事，那会把测速流量也导到境外节点、结果失真。
# ⚠ 走代理的那一跳**不能钉 IP**（域名由代理侧解析），因此失去 DNS 重绑定防护；
#   名单必须是运维显式配置的主机，且仍要过 ALLOWED_SOURCE_HOSTS 白名单。
SOURCE_PROXY=
SOURCE_PROXY_HOSTS=
